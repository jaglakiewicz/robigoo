{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Session": {
    "TimeoutMinutes": 30,
    "CleanupIntervalMinutes": 15
  },
  "Jwt": {
    "Key": "CHANGE_THIS_TO_A_SECURE_256_BIT_KEY_IN_PRODUCTION_ENV_VARIABLE",
    "Issuer": "SKO",
    "Audience": "SKOUsers",
    "AccessTokenExpirationMinutes": 30,
    "RefreshTokenExpirationDays": 7
  },
  "Security": {
    "AllowedOrigins": [ "http://localhost:4200", "https://localhost:4200" ],
    "AllowedHeaders": [ "Content-Type", "Authorization", "Accept", "Accept-Language", "X-Requested-With", "X-Correlation-Id", "Cache-Control", "Pragma" ],
    "PasswordMinLength": 8,
    "RequireUppercase": true,
    "RequireLowercase": true,
    "RequireDigit": true,
    "RequireSpecialChar": false
  },
  "RateLimiting": {
    "LoginPermitLimit": 5,
    "LoginWindowMinutes": 1,
    "GeneralPermitLimit": 100,
    "GeneralWindowMinutes": 1,
    "AuthenticatedUserPermitLimit": 200,
    "AuthenticatedUserWindowMinutes": 1
  },
  "AccountLockout": {
    "MaxFailedAttempts": 5,
    "LockoutDurationMinutes": 15
  },
  "ProgressiveDelay": {
    "BaseDelayMilliseconds": 1000,
    "MaxDelayMilliseconds": 16000
  },
  "RateLimitBlocking": {
    "ViolationThreshold": 10,
    "BlockDurationMinutes": 30,
    "ViolationWindowMinutes": 5
  }
}
